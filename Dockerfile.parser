FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml ./
COPY src ./src

RUN python -m pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 scraper \
    && mkdir -p /app/data \
    && chown -R scraper:scraper /app/data

USER scraper

EXPOSE 50051

CMD ["python", "-m", "books_scraper.parser_main"]
